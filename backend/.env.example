ENVIRONMENT=development
SECRET_KEY=replace-with-at-least-64-random-characters

# SQLite now. For PostgreSQL later:
# DATABASE_URL=postgresql+asyncpg://ev:password@postgres:5432/ev
DATABASE_URL=sqlite+aiosqlite:///./data/ev.db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.com

STORAGE_BACKEND=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=evminio
MINIO_SECRET_KEY=replace-minio-password
MINIO_BUCKET=ev-media
MINIO_SECURE=false
MAX_IMAGE_MB=15
MAX_VIDEO_MB=100
